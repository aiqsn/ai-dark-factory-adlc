diff --git a/src/index.js b/src/index.js
index 67ab9fa..4530f6d 100644
--- a/src/index.js
+++ b/src/index.js
@@ -34,7 +34,8 @@ export default {
 
     if (url.pathname === "/api/search") {
       const q = (url.searchParams.get("q") ?? "").trim();
-      if (!q) return Response.json({ error: "missing q" }, { status: 400 });
+      const hasLetterOrDigit = /[\p{L}\p{N}]/u.test(q);
+      if (!hasLetterOrDigit) return Response.json({ error: "missing q" }, { status: 400 });
       return Response.json({ query: q, results: search(q) });
     }
 
diff --git a/test/index.test.js b/test/index.test.js
index a0ee60b..7cd0989 100644
--- a/test/index.test.js
+++ b/test/index.test.js
@@ -38,3 +38,15 @@ test("a missing or blank query is a 400 with a clear error", async () => {
 test("unknown paths are 404", async () => {
   assert.equal((await call("/nope")).status, 404);
 });
+
+test("punctuation-only queries are blank", async () => {
+  for (const q of ["%3F%21", "...", "%20-%20"]) {
+    const res = await call(`/api/search?q=${q}`);
+    assert.equal(res.status, 400);
+    assert.deepEqual(await res.json(), { error: "missing q" });
+  }
+});
+
+test("queries with letters still search", async () => {
+  assert.equal((await call("/api/search?q=jacket!")).status, 200);
+});
